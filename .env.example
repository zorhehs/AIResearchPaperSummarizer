# Required — does the actual summarization work.
GROQ_API_KEY=gsk_your_key_here

# Optional — your contact address. Unpaywall requires one on every request, so
# leaving this unset skips Unpaywall entirely and DOI lookups fall back to
# Crossref metadata alone (no open-access PDF fetching).
UNPAYWALL_EMAIL=you@example.com

# Optional — where the SQLite file (sessions, daily usage, summary cache) lives.
# Defaults to ./users.db next to the repo root. In Docker this must point at a
# mounted volume or the database is lost when the container is recreated.
# DB_PATH=/app/data/users.db
