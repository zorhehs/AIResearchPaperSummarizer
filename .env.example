# Required — does the actual summarization work.
GROQ_API_KEY=gsk_your_key_here

# Optional — your contact address. Unpaywall requires one on every request, so
# leaving this unset skips Unpaywall entirely and DOI lookups fall back to
# Crossref metadata alone (no open-access PDF fetching).
UNPAYWALL_EMAIL=you@example.com

# Optional — where the SQLite file (sessions, daily usage, summary cache) lives.
# Defaults to ./users.db next to the repo root. In Docker this must point at a
# mounted volume or the database is lost when the container is recreated.
# DB_PATH=/app/data/users.db

# Optional — per-address daily summary cap, as a backstop for the cookie-based
# session limit. 0 (default) disables it. See the README note before enabling:
# shared NAT addresses mean this can punish ordinary users.
IP_DAILY_LIMIT=0

# Only enable behind a proxy you control. Any client can forge X-Forwarded-For,
# so trusting it on a directly-exposed app defeats IP_DAILY_LIMIT entirely.
TRUST_PROXY_HEADERS=0

# Optional — OCR fallback for scanned PDFs. Active when Tesseract is installed;
# set to 0 to return an error for scans instead of spending seconds per page.
ENABLE_OCR=1
OCR_MAX_PAGES=20

# Optional — application log level (DEBUG, INFO, WARNING, ERROR). Default INFO.
LOG_LEVEL=INFO
